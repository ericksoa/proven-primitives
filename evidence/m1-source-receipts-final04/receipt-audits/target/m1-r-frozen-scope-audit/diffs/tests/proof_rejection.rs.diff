+#[test]
+#[ignore = "requires VERUS_ROOT pointing at the pinned Verus distribution"]
+fn the_prover_rejects_five_m1_malformed_suffix_defects() {
+    let verus_root = PathBuf::from(std::env::var_os("VERUS_ROOT").expect("set VERUS_ROOT"));
+    let verus = verus_root.join(if cfg!(windows) { "verus.exe" } else { "verus" });
+    let project = Path::new(env!("CARGO_MANIFEST_DIR"));
+    let temporary = std::env::temp_dir().join(format!(
+        "proven-primitives-m1-malformed-suffix-canary-{}",
+        std::process::id(),
+    ));
+    fs::create_dir(&temporary).expect("fresh private temporary directory");
+    fs::create_dir(temporary.join("src")).unwrap();
+    for entry in fs::read_dir(project.join("src")).unwrap() {
+        let entry = entry.unwrap();
+        if entry.file_type().unwrap().is_file() {
+            fs::copy(entry.path(), temporary.join("src").join(entry.file_name())).unwrap();
+        }
+    }
+    fs::create_dir_all(project.join("evidence")).unwrap();
+    let path = temporary.join("src/brotli_input.rs");
+    let original = fs::read_to_string(&path).unwrap();
+    for (name, function, old, new) in [
+        ("brotli-m1-malformed-suffix-invalid-fields-undercharge", "plan_initial_suffix_action", "if kind >= 3 || subphase != 1 || symbol >= 26 {\n        return Ok(CompressedActionPlan { planning_work: 0, execution_work: 4 + 1, consumed: 0,\n            status: Some(CompressedHeaderStatus::Failed(CompressedHeaderError::InternalState)) });\n    }", "if kind >= 3 || subphase != 1 || symbol >= 26 {\n        return Ok(CompressedActionPlan { planning_work: 0, execution_work: 4, consumed: 0,\n            status: Some(CompressedHeaderStatus::Failed(CompressedHeaderError::InternalState)) });\n    }"),
+        ("brotli-m1-malformed-suffix-wrong-width-undercharge", "plan_initial_suffix_action", "if width != expected_width {\n        return Ok(CompressedActionPlan { planning_work: 1, execution_work: 1 + 4 + 1, consumed: 0,\n            status: Some(CompressedHeaderStatus::Failed(CompressedHeaderError::InternalState)) });\n    }", "if width != expected_width {\n        return Ok(CompressedActionPlan { planning_work: 1, execution_work: 1 + 4, consumed: 0,\n            status: Some(CompressedHeaderStatus::Failed(CompressedHeaderError::InternalState)) });\n    }"),
+        ("brotli-m1-malformed-suffix-bad-kind-is-truncated", "advance_initial_block_length_phase", "if kind >= 3 {\n                        proof { assert(source_units + 5 == m1_bad_initial_suffix_validation_reads(suffix_original, self.window_bytes) + 5); }\n                        return self.fail_phase(consumed, CompressedHeaderError::InternalState);\n                    }", "if kind >= 3 {\n                        proof { assert(source_units + 5 == m1_bad_initial_suffix_validation_reads(suffix_original, self.window_bytes) + 5); }\n                        let malformed_error = match state_byte(self.workspace, self.window_bytes, B3B_BLOCK_LENGTH_PHASE) {\n                            Ok(1) => CompressedHeaderError::Truncated,\n                            _ => CompressedHeaderError::InternalState,\n                        };\n                        return self.fail_phase(consumed, malformed_error);\n                    }"),
+        ("brotli-m1-malformed-suffix-fallback-undercharge", "advance_planned_compressed_action", "if !budget.charge_work(4 + 1) {\n            proof {\n                if initial_outer == 3 && m1_bad_initial_suffix(old(workspace)@, window_bytes) {\n                    reveal(m1_bad_initial_suffix_validation_reads); reveal(m1_bad_initial_suffix_owner_effect);\n                    assert(m1_bad_initial_suffix_validation_reads(old(workspace)@, window_bytes) == 0);\n                    assert(m1_bad_initial_suffix_owner_effect(old(workspace)@, workspace@, window_bytes,\n                        *old(budget), *budget,\n                        Err(CompressedStep { consumed: 0, status: CompressedStatus::Failed(CoreFailure::ResourceLimit) })));\n                }\n            }\n            return Err(CompressedStep { consumed: 0,\n                status: CompressedStatus::Failed(CoreFailure::ResourceLimit) });\n        }", "if !budget.charge_work(if initial_outer == 3 { 4 } else { 4 + 1 }) {\n            proof {\n                if initial_outer == 3 && m1_bad_initial_suffix(old(workspace)@, window_bytes) {\n                    reveal(m1_bad_initial_suffix_validation_reads); reveal(m1_bad_initial_suffix_owner_effect);\n                    assert(m1_bad_initial_suffix_validation_reads(old(workspace)@, window_bytes) == 0);\n                    assert(m1_bad_initial_suffix_owner_effect(old(workspace)@, workspace@, window_bytes,\n                        *old(budget), *budget,\n                        Err(CompressedStep { consumed: 0, status: CompressedStatus::Failed(CoreFailure::ResourceLimit) })));\n                }\n            }\n            return Err(CompressedStep { consumed: 0,\n                status: CompressedStatus::Failed(CoreFailure::ResourceLimit) });\n        }"),
+        ("brotli-m1-malformed-suffix-fallback-writes-byte175", "advance_planned_compressed_action", "if store_terminal_error(workspace, window_bytes, CompressedHeaderError::InternalState).is_err() {\n            return Err(CompressedStep { consumed: 0,\n                status: CompressedStatus::Failed(core_state_failure()) });\n        }", "if store_terminal_error(workspace, window_bytes, CompressedHeaderError::InternalState).is_err() {\n            return Err(CompressedStep { consumed: 0,\n                status: CompressedStatus::Failed(core_state_failure()) });\n        }\n        if initial_outer == 3 {\n            let _ = put_state_byte(workspace, window_bytes, 175, 1);\n        }"),
+    ] {
+        let start = original.find(&format!("fn {function}(")).expect("selected function exists");
+        let indent = original[..start].rsplit('\n').next().unwrap().len();
+        let closing = format!("\n{}}}\n", " ".repeat(indent));
+        let end = start + original[start..].find(&closing).expect("selected function ends") + closing.len();
+        let selected = &original[start..end];
+        let opening = format!("\n{}{{\n", " ".repeat(indent));
+        let body = selected.find(&opening).expect("function body");
+        let (scope_start, scope_end) = (body, selected.len());
+        assert_eq!(selected[scope_start..scope_end].matches(old).count(), 1, "unique body mutation for {name}");
+        let replacement = format!("{}{}{}", &selected[..scope_start],
+            selected[scope_start..scope_end].replacen(old, new, 1), &selected[scope_end..]);
+        assert_eq!(&replacement[..body], &selected[..body], "unchanged root contract");
+        let mutated = format!("{}{}{}", &original[..start], replacement, &original[end..]);
+        fs::write(&path, mutated).unwrap();
+        let result = check_brotli_input_function(&verus, &temporary, function);
+        let log = transcript(&result);
+        fs::write(project.join("evidence").join(format!("canary-{name}.log")), &log).unwrap();
+        assert!(!result.status.success(), "prover accepted {name}");
+        assert!(log.contains("postcondition not satisfied")
+            || log.contains("precondition not satisfied")
+            || log.contains("requires not satisfied")
+            || log.contains("invariant not satisfied")
+            || log.contains("assertion failed"),
+            "expected a proof rejection, not a tooling error: {log}");
+        let lower = log.to_ascii_lowercase();
+        assert!(!lower.contains("resource limit") && !lower.contains("panicked")
+            && !lower.contains("expected rlimit-count") && !lower.contains("unexpected smt output") && !lower.contains("internal compiler error"),
+            "tool/resource failure is not a semantic rejection: {log}");
+        println!("REJECTED {name}: deliberate executable defect, unchanged specification");
+        fs::write(&path, &original).unwrap();
+    }
+    fs::remove_dir_all(temporary).unwrap();
+}
