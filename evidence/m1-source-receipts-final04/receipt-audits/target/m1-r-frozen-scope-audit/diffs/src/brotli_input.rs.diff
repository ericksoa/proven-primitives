+#[verifier::opaque]
+spec fn m1_context_bad_saved_cursor(w: Seq<u8>, window: u32) -> bool {
+    let outer = b3b_scalar_byte_at(w, window, B3B_OUTER_PHASE);
+    let phase = b3b_scalar_byte_at(w, window, B3B_CONTEXT_PHASE);
+    &&& 6 <= outer <= 7
+    &&& ((phase == 0 && (!b3b_queue_encoding_valid(w, window) || !var_uint8_encoding_valid(w, window)))
+        || ((phase == 1 || phase == 2 || phase == 5 || phase == 6) && !b3b_queue_encoding_valid(w, window)))
+}
+
+#[verifier::opaque]
+spec fn m1_context_cursor_failure_plan(w: Seq<u8>, window: u32, plan: CompressedActionPlan) -> bool {
+    &&& m1_context_bad_saved_cursor(w, window)
+    &&& plan.planning_work == 0 && plan.execution_work == 5 && plan.consumed == 0
+    &&& plan.status == Some(CompressedHeaderStatus::Failed(CompressedHeaderError::InternalState))
+}
+
+#[verifier::opaque]
+spec fn m1_context_cursor_owner_effect(before: Seq<u8>, after: Seq<u8>, window: u32,
+    start: crate::brotli::RequestBudget, end: crate::brotli::RequestBudget,
+    result: Result<usize, CompressedStep>) -> bool {
+    &&& end.input_remaining == start.input_remaining
+    &&& end.output_remaining == start.output_remaining
+    &&& end.calls_remaining == start.calls_remaining
+    &&& end.initializations_remaining == start.initializations_remaining
+    &&& if start.work_remaining >= 5 {
+        &&& result == Err(CompressedStep { consumed: 0, status: CompressedStatus::Failed(
+            CoreFailure::InvalidFormat(CoreFormatDetail::StateEncoding)) })
+        &&& end.work_remaining == start.work_remaining - 5
+        &&& terminal_error_frame(before, after, window)
+        &&& serialized_terminal_error(after, window, CompressedHeaderError::InternalState)
+    } else {
+        &&& result == Err(CompressedStep { consumed: 0, status: CompressedStatus::Failed(CoreFailure::ResourceLimit) })
+        &&& after == before && end == start
+    }
 }
 
