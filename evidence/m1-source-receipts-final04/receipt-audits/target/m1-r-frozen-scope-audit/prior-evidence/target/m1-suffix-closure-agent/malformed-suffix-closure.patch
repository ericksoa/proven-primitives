+
+#[verifier::opaque]
+spec fn m1_bad_initial_suffix(before: Seq<u8>, window_bytes: u32) -> bool {
+    let kind = b3b_scalar_byte_at(before, window_bytes, B3B_CURRENT_KIND);
+    let symbol = b3b_scalar_byte_at(before, window_bytes, B3B_BLOCK_LENGTH_SYMBOL);
+    let width = b3b_scalar_byte_at(before, window_bytes, B3B_BLOCK_LENGTH_SUFFIX_WIDTH);
+    let phase = b3b_scalar_byte_at(before, window_bytes, B3B_BLOCK_LENGTH_PHASE);
+    &&& phase != 0
+    &&& (phase != 1 || kind >= 3 || symbol >= 26
+        || (symbol < 26 && width != crate::brotli_prefix::BLOCK_LENGTH_EXTRA_BITS@[symbol as int])
+        || !b3b_queue_encoding_valid(before, window_bytes))
+}
+
+#[verifier::opaque]
+spec fn m1_bad_initial_suffix_validation_reads(before: Seq<u8>, window_bytes: u32) -> nat {
+    if b3b_scalar_byte_at(before, window_bytes, B3B_BLOCK_LENGTH_PHASE) == 1
+        && b3b_scalar_byte_at(before, window_bytes, B3B_CURRENT_KIND) < 3
+        && b3b_scalar_byte_at(before, window_bytes, B3B_BLOCK_LENGTH_SYMBOL) < 26 { 1nat } else { 0nat }
+}
+
+#[verifier::opaque]
+spec fn m1_bad_initial_suffix_plan(before: Seq<u8>, window_bytes: u32, plan: CompressedActionPlan) -> bool {
+    &&& m1_bad_initial_suffix(before, window_bytes)
+    &&& plan.planning_work as nat == m1_bad_initial_suffix_validation_reads(before, window_bytes)
+    &&& plan.execution_work as nat == m1_bad_initial_suffix_validation_reads(before, window_bytes) + 5
+    &&& plan.consumed == 0
+    &&& plan.status == Some(CompressedHeaderStatus::Failed(CompressedHeaderError::InternalState))
+}
+
+proof fn m1_initial_suffix_domain_partition(before: Seq<u8>, window_bytes: u32)
+    ensures
+        m1_bad_initial_suffix(before, window_bytes)
+            == (b3b_scalar_byte_at(before, window_bytes, B3B_BLOCK_LENGTH_PHASE) != 0
+                && !initial_suffix_read_domain(before, window_bytes)),
+        m1_bad_initial_suffix_validation_reads(before, window_bytes) <= 1,
+{
+    reveal(m1_bad_initial_suffix); reveal(initial_suffix_read_domain);
+    reveal(m1_bad_initial_suffix_validation_reads);
+}
+
+#[verifier::opaque]
+spec fn m1_bad_initial_suffix_owner_effect(before: Seq<u8>, after: Seq<u8>, window_bytes: u32,
+    start: crate::brotli::RequestBudget, end: crate::brotli::RequestBudget,
+    result: Result<usize, CompressedStep>) -> bool {
+    let planning = m1_bad_initial_suffix_validation_reads(before, window_bytes);
+    let execution = planning + 5;
+    &&& end.limits == start.limits
+    &&& end.input_remaining == start.input_remaining
+    &&& end.output_remaining == start.output_remaining
+    &&& end.calls_remaining == start.calls_remaining
+    &&& end.initializations_remaining == start.initializations_remaining
+    &&& if start.work_remaining as nat >= planning + execution {
+        &&& result == Err(CompressedStep { consumed: 0,
+            status: CompressedStatus::Failed(CoreFailure::InvalidFormat(CoreFormatDetail::StateEncoding)) })
+        &&& end.work_remaining as nat + planning + execution == start.work_remaining as nat
+        &&& terminal_error_frame(before, after, window_bytes)
+        &&& serialized_terminal_error(after, window_bytes, CompressedHeaderError::InternalState)
+    } else {
+        &&& result == Err(CompressedStep { consumed: 0, status: CompressedStatus::Failed(CoreFailure::ResourceLimit) })
+        &&& after == before
+        &&& end.work_remaining as nat
+            + if start.work_remaining as nat >= planning { planning } else { 0nat }
+                == start.work_remaining as nat
+        &&& (planning == 0 || (start.work_remaining as nat) < planning ==> end == start)
+    }
 }
 
+proof fn m1_bad_initial_suffix_owner_without_plan(before: Seq<u8>, window_bytes: u32,
+    start: crate::brotli::RequestBudget)
+    requires (start.work_remaining as nat) < m1_bad_initial_suffix_validation_reads(before, window_bytes),
+    ensures m1_bad_initial_suffix_owner_effect(before, before, window_bytes, start, start,
+        Err(CompressedStep { consumed: 0, status: CompressedStatus::Failed(CoreFailure::ResourceLimit) })),
+{
+    reveal(m1_bad_initial_suffix_owner_effect);
+}
+
+proof fn m1_bad_initial_suffix_owner_from_execution(before: Seq<u8>, after: Seq<u8>, window_bytes: u32,
+    start: crate::brotli::RequestBudget, end: crate::brotli::RequestBudget,
+    plan: CompressedActionPlan, execution_credit: u64, result: Result<usize, CompressedStep>)
+    requires
+        m1_bad_initial_suffix_plan(before, window_bytes, plan),
+        end.limits == start.limits,
+        end.input_remaining == start.input_remaining,
+        end.output_remaining == start.output_remaining,
+        end.calls_remaining == start.calls_remaining,
+        end.initializations_remaining == start.initializations_remaining,
+        execution_credit as nat + plan.planning_work as nat == start.work_remaining as nat,
+        if execution_credit >= plan.execution_work {
+            &&& result == Err(CompressedStep { consumed: 0,
+                status: CompressedStatus::Failed(CoreFailure::InvalidFormat(CoreFormatDetail::StateEncoding)) })
+            &&& terminal_error_frame(before, after, window_bytes)
+            &&& serialized_terminal_error(after, window_bytes, CompressedHeaderError::InternalState)
+            &&& end.work_remaining as nat + plan.execution_work as nat == execution_credit as nat
+        } else {
+            &&& result == Err(CompressedStep { consumed: 0, status: CompressedStatus::Failed(CoreFailure::ResourceLimit) })
+            &&& after == before
+            &&& end.work_remaining == execution_credit
+        },
+    ensures m1_bad_initial_suffix_owner_effect(before, after, window_bytes, start, end, result),
+{
+    reveal(m1_bad_initial_suffix_plan); reveal(m1_bad_initial_suffix_owner_effect);
+}
