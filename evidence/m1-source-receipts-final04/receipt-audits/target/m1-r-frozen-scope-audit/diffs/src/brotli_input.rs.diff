+#[verifier::opaque]
+spec fn m1_suffix_fallback_image() -> Seq<u8> {
+    let window = 1024u32;
+    let base = b3b_scalar_base(window);
+    Seq::new(window as nat + crate::brotli_prefix::FIXED_SCRATCH_BYTES as nat,
+        |i: int| if i == base + B3B_MTF_UPPER_BOUND as int { 63u8 }
+            else if i == base + B3B_OUTER_PHASE as int { 3u8 }
+            else if i == base + B3B_BLOCK_LENGTH_PHASE as int { 2u8 }
+            else { 0u8 })
+}
+
+proof fn m1_suffix_fallback_image_is_admitted()
+    ensures
+        b3c_workspace_shape(m1_suffix_fallback_image().len(), 1024),
+        compressed_decoder_state_ok(m1_suffix_fallback_image(), 1024),
