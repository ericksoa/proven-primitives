+                    region,
+                    tree,
+                );
+                assert forall|i: int| 0 <= i < before_metadata.len()
+                    && !(at <= i < at + 4) implies
+                    #[trigger] workspace@[i] == before_metadata[i] by {}
+                metadata_frame_preserves_context_state(
+                    before_metadata,
+                    workspace@,
+                    window_bytes,
+                    region,
+                    tree,
+                );
+                assert(b3b_scalar_byte_at(
+                    workspace@,
+                    window_bytes,
+                    B3B_ACTIVE_REGION,
+                ) == b3b_scalar_byte_at(
+                    before_metadata,
+                    window_bytes,
+                    B3B_ACTIVE_REGION,
+                ));
+                assert(b3b_scalar_u16_at(
+                    workspace@,
+                    window_bytes,
+                    B3B_ACTIVE_TREE,
+                ) == b3b_scalar_u16_at(
+                    before_metadata,
+                    window_bytes,
+                    B3B_ACTIVE_TREE,
+                ));
+                assert(b3b_scalar_u16_at(
+                    workspace@,
+                    window_bytes,
+                    B3B_ALPHABET_LIMIT,
+                ) == b3b_scalar_u16_at(
+                    before_metadata,
+                    window_bytes,
+                    B3B_ALPHABET_LIMIT,
+                ));
+                assert(b3b_scalar_byte_at(
+                    before_metadata,
+                    window_bytes,
+                    B3B_ACTIVE_REGION,
+                ) == b3b_scalar_byte_at(
+                    original,
+                    window_bytes,
+                    B3B_ACTIVE_REGION,
+                ));
+                assert(b3b_scalar_u16_at(
+                    before_metadata,
+                    window_bytes,
+                    B3B_ACTIVE_TREE,
+                ) == b3b_scalar_u16_at(
+                    original,
+                    window_bytes,
+                    B3B_ACTIVE_TREE,
+                ));
+                assert(b3b_scalar_u16_at(
+                    before_metadata,
+                    window_bytes,
+                    B3B_ALPHABET_LIMIT,
+                ) == b3b_scalar_u16_at(
+                    original,
+                    window_bytes,
+                    B3B_ALPHABET_LIMIT,
+                ));
+                assert(decoder.alphabet_limit as nat == b3b_scalar_u16_at(
+                    original,
+                    window_bytes,
+                    B3B_ALPHABET_LIMIT,
+                ));
+                reveal(tree_metadata_complete);
+                assert(tree_metadata_complete(
+                    workspace@,
+                    window_bytes,
+                    region,
+                    tree,
+                    decoder.alphabet_limit,
+                ));
+                assert(b3b_scalar_byte_at(
+                    workspace@,
+                    window_bytes,
+                    B3B_ACTIVE_REGION,
+                ) == tree_region_tag_spec(region));
+                assert(b3b_scalar_u16_at(
+                    workspace@,
+                    window_bytes,
+                    B3B_ACTIVE_TREE,
+                ) == tree);
+                assert(b3b_scalar_u16_at(
+                    workspace@,
+                    window_bytes,
+                    B3B_ALPHABET_LIMIT,
+                ) == decoder.alphabet_limit);
+                active_tree_complete_from_fields(
+                    workspace@,
+                    window_bytes,
+                    region,
+                    tree,
+                    decoder.alphabet_limit,
+                );
+            }
+            return Ok(());
+        }
+        Err(error) => return Err(CompressedHeaderError::Workspace(error)),
+    }
