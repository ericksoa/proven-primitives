+    #[test]
+    fn m1_context_cursor_failures_match_w1_and_prepay_terminal() {
+        use crate::brotli::{RequestBudget, RequestLimits};
+        let window = 1024u32;
+        let bytes = crate::brotli_prefix::required_workspace_bytes(10).unwrap() as usize;
+        let base = window as usize + B3B_SCALAR_OFFSET as usize;
+        let mut cases = 0usize;
+        let mut mismatches = 0usize;
+        for outer in [6u8, 7] {
+            for kind in [0u8, 1] {
+                for phase in [0u8, 1, 2, 5, 6] {
+                    // Four queue encodings plus every invalid var-int encoding
+                    // class. The latter are active only in count phase zero.
+                    let faults = if phase == 0 { 9u8 } else { 4u8 };
+                    for fault in 0..faults {
+                        let mut original = vec![0u8; bytes];
+                        original[base + B3B_MTF_UPPER_BOUND as usize] = 63;
+                        original[base + B3B_OUTER_PHASE as usize] = outer;
+                        original[base + B3B_CONTEXT_KIND as usize] = kind;
+                        original[base + B3B_CONTEXT_PHASE as usize] = phase;
+                        original[base + B3B_MAP_SIZE as usize] = 1;
+                        if phase != 0 { original[base + B3B_MAP_TREES as usize] = 1; }
+                        if phase == 5 { original[base + B3B_PENDING_RUN as usize] = 1; }
+                        if phase == 6 {
+                            original[base + B3B_MAP_INDEX as usize] = 1;
+                            original[base + B3B_MAP_INITIALIZED as usize] = 1;
+                        }
+                        match fault {
+                            0 => original[base + B3B_QUEUE_LEN as usize] = 9,
+                            1 => original[base + B3B_QUEUE_OFFSET_BYTE as usize] = 1,
+                            2 => {
+                                original[base + B3B_QUEUE_LEN as usize] = 1;
+                                original[base + B3B_QUEUE_OFFSET_BYTE as usize] = 8;
+                            },
+                            3 => original[base + 7] = 1,
+                            4 => original[base + B3B_VAR_PHASE as usize] = 255,
+                            5 => original[base + B3B_VAR_WIDTH as usize] = 1,
+                            6 => {
+                                original[base + B3B_VAR_PHASE as usize] = 1;
+                                original[base + B3B_VAR_WIDTH as usize] = 1;
+                            },
+                            7 => original[base + B3B_VAR_PHASE as usize] = 2,
+                            _ => {
+                                original[base + B3B_VAR_PHASE as usize] = 2;
+                                original[base + B3B_VAR_WIDTH as usize] = 8;
+                            },
+                        }
+                        let phase_enum = if outer == 6 { CompressedOuterPhase::LiteralContextMap }
+                            else { CompressedOuterPhase::DistanceContextMap };
+                        let mut expected = original.clone();
+                        let w1 = CompressedMetaBlockDecoder { workspace: &mut expected, window_bytes: window }
+                            .advance_outer_phase_once(phase_enum, &[], false);
+                        assert_eq!(w1, (0, Some(CompressedHeaderStatus::Failed(CompressedHeaderError::InternalState))));
+                        for work in [5u64, 4, 0, 6] {
+                            cases += 1;
+                            let mut actual = original.clone();
+                            let mut budget = RequestBudget::new(RequestLimits {
+                                max_input: 3, max_output: 5, max_work: work, max_calls: 7,
+                                max_initializations: 11, max_window_bits: 16,
+                            }).unwrap();
+                            let got = advance_planned_compressed_action(&mut actual, window, &mut budget, &[], false);
+                            let wanted = Err(CompressedStep { consumed: 0, status: CompressedStatus::Failed(
+                                if work < 5 { CoreFailure::ResourceLimit } else { core_state_failure() }) });
+                            let expected_workspace = if work < 5 { &original } else { &expected };
+                            let expected_work = if work < 5 { work } else { work - 5 };
+                            let matching = got == wanted && actual == *expected_workspace
+                                && budget.work_remaining == expected_work
+                                && (budget.input_remaining, budget.output_remaining, budget.calls_remaining,
+                                    budget.initializations_remaining) == (3, 5, 7, 11);
+                            if !matching {
+                                if mismatches == 0 {
+                                    let first = actual.iter().zip(expected_workspace).position(|(a, b)| a != b);
+                                    println!("first cursor mismatch outer={outer} kind={kind} phase={phase} fault={fault} credit={work}: result={got:?}, work={}, first_byte_difference={first:?}", budget.work_remaining);
+                                }
+                                mismatches += 1;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        println!("cursor comparisons={cases}, mismatches={mismatches}");
+        assert_eq!(mismatches, 0);
+    }
+
+}
