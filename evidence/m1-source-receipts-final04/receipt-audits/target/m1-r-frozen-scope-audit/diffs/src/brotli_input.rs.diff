+        b3b_scalar_byte_at(m1_suffix_fallback_image(), 1024, B3B_BLOCK_LENGTH_PHASE) == 2,
+        b3b_scalar_byte_at(m1_suffix_fallback_image(), 1024, B3B_MTF_UPPER_BOUND) == 63,
+        m1_suffix_fallback_image()[b3b_scalar_base(1024) + 175] == 0,
+{
+    reveal(m1_suffix_fallback_image);
+    reveal(b3b_scalar_base); reveal(b3b_scalar_byte_at); reveal(b3b_scalar_u16_at);
+    reveal(b3b_workspace_shape); reveal(serialized_mtf_state_ok);
+    reveal(compressed_decoder_state_ok); reveal(b3c_workspace_shape);
+    b3b_scalar_layout_is_exact();
+    assert((1024u32 & ((1024u32 - 1) as u32)) == 0) by (bit_vector);
+}
