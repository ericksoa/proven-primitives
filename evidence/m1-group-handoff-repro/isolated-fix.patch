+    #[test]
+    fn m1_group_handoff_missing_next_count_diagnostic() {
+        use crate::brotli::{RequestBudget, RequestLimits};
+        for next_count in [0u16, 257, u16::MAX, 1, 256] {
+            let bad_count = next_count == 0 || next_count > 256;
+            let (mut workspace, window) = fresh_b3b_workspace();
+            workspace.resize(workspace.len() + 131_072, 0);
+            assert!(1024 <= window && window <= 16_777_216 && window.is_power_of_two());
+            assert!(workspace.len() >= window as usize + crate::brotli_prefix::FIXED_SCRATCH_BYTES as usize);
+            put_state_u16(&mut workspace, window, B3B_MAP_SIZE, 1).unwrap();
+            put_state_u16(&mut workspace, window, B3B_LITERAL_TREES, 1).unwrap();
+            put_state_u16(&mut workspace, window, B3B_BLOCK_COUNTS + 2, next_count).unwrap();
+            {
+                let mut decoder = CompressedMetaBlockDecoder { workspace: &mut workspace[..], window_bytes: window };
+                decoder.start_tree_group(0, CompressedOuterPhase::LiteralTreeGroup).unwrap();
+            }
+            store_code_description_decoder(&mut workspace, window, CodeDescriptionDecoder {
+                queue: BitQueue::new(), alphabet_max: 256, alphabet_limit: 256,
+                phase: CodeDescriptionPhase::CompleteSimple(SimpleCodeDescription {
+                    selector: 0, count: 1, symbols: [0, 0xffff, 0xffff, 0xffff] }),
+            }).unwrap();
+            for field in [B3B_MAP_INDEX, B3B_MAP_INITIALIZED, B3B_MAP_TREES, B3B_TREE_INDEX, B3B_ACTIVE_TREE] {
+                assert_eq!(state_u16(&workspace, window, field).unwrap(), 0);
+            }
+            for field in [B3B_MAP_SIZE, B3B_LITERAL_TREES, B3B_TREE_COUNT] {
+                assert_eq!(state_u16(&workspace, window, field).unwrap(), 1);
+            }
+            for field in [B3B_ALPHABET_MAX, B3B_ALPHABET_LIMIT] {
+                assert_eq!(state_u16(&workspace, window, field).unwrap(), 256);
+            }
+            for (field, value) in [(B3B_MTF_UPPER_BOUND, 63), (B3B_CONTEXT_PHASE, 0),
+                (B3B_CONTEXT_KIND, 0), (B3B_MAX_RUN_PREFIX, 0), (B3B_OUTER_PHASE, 8),
+                (B3B_GROUP_KIND, 0), (B3B_GROUP_PHASE, 1), (B3B_ACTIVE_REGION, 0)] {
+                assert_eq!(state_byte(&workspace, window, field).unwrap(), value);
+            }
+            assert_eq!(state_u16(&workspace, window, B3B_BLOCK_COUNTS + 2).unwrap(), next_count);
+            let limits = |max_work| RequestLimits { max_input: 0, max_output: 0, max_work,
+                max_calls: 0, max_initializations: 0, max_window_bits: 16 };
+            let mut tree_budget = RequestBudget::new(limits(u64::MAX)).unwrap();
+            let tree = plan_serialized_tree(&workspace, window, &mut tree_budget, &[], false).unwrap();
+            assert_eq!(tree.status, SerializedTreeStatus::Complete);
+            let mut plan_budget = RequestBudget::new(limits(u64::MAX)).unwrap();
+            let plan = plan_tree_group_action(&workspace, window, &mut plan_budget, &[], false).unwrap();
+            let expected_execution = tree.execution_work + if bad_count { 5 } else { tree_group_start_work() };
+            assert_eq!(plan.planning_work, tree.planning_work);
+            assert_eq!(plan.execution_work, expected_execution);
+            let mut actual_workspace = workspace.clone();
+            let actual = {
+                let mut decoder = CompressedMetaBlockDecoder { workspace: &mut actual_workspace[..], window_bytes: window };
+                decoder.advance_outer_phase_once(CompressedOuterPhase::LiteralTreeGroup, &[], false)
+            };
+            println!("next_count={next_count}; plan=({}, {:?}, {}); actual={:?}", plan.consumed, plan.status, plan.execution_work, actual);
+            assert_eq!((plan.consumed, plan.status), actual);
+            let exact_work = plan.planning_work + expected_execution;
+            let mut exact_workspace = workspace.clone();
+            let mut exact_budget = RequestBudget::new(limits(exact_work)).unwrap();
+            let exact = advance_planned_tree_group(&mut exact_workspace, window, &mut exact_budget,
+                CompressedOuterPhase::LiteralTreeGroup, &[], false);
+            if bad_count {
+                assert!(matches!(exact, Err(CompressedStep { consumed: 0,
+                    status: CompressedStatus::Failed(CoreFailure::InvalidFormat(CoreFormatDetail::StateEncoding)) })));
+            } else { assert_eq!(exact, Ok(0)); }
+            assert_eq!(exact_budget.work_remaining, 0);
+            let mut short_workspace = workspace.clone();
+            let mut short_budget = RequestBudget::new(limits(exact_work - 1)).unwrap();
+            assert!(matches!(advance_planned_tree_group(&mut short_workspace, window, &mut short_budget,
+                CompressedOuterPhase::LiteralTreeGroup, &[], false), Err(CompressedStep { consumed: 0,
+                    status: CompressedStatus::Failed(CoreFailure::ResourceLimit) })));
+            assert_eq!(short_workspace, workspace);
+        }
+    }
+
